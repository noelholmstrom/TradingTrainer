# Copy this file to .env.local and fill in what you use.
# Everything is optional: with nothing set, the site runs in guest mode
# (no accounts, journal kept in the browser, AI coach off).

# --- Accounts and cloud journal (Supabase) ---------------------------------
# Supabase dashboard -> Connect -> Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI coach (Claude API) ---------------------------------------------------
# console.anthropic.com -> API keys. Leave empty to keep the AI coach off.
ANTHROPIC_API_KEY=
# Model for trade reviews. Haiku is fast and cheap; Sonnet writes deeper reviews.
COACH_MODEL=claude-haiku-5-5
# AI reviews each signed-in user can request per 24 hours.
COACH_DAILY_LIMIT=40

# --- Real market data (Databento) ---------------------------------------------
# Optional. Anyone can use real data with their own key from the replay's Data panel.
# These let the listed accounts use the site's own key instead (licensed for your own use).
DATABENTO_API_KEY=
# Comma-separated emails of the accounts allowed to use DATABENTO_API_KEY.
DATA_OWNER_EMAILS=
